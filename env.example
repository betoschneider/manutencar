# ManutenCar - Configuração de Ambiente

## Banco de Dados
DATABASE_URL=sqlite:///./manutencar.db

## Limite de Contas (0 = ilimitado)
ACCOUNT_QUOTE=0

## Google OAuth (opcional - para login com Google)
# 1. Acesse https://console.cloud.google.com/apis/credentials
# 2. Crie um "ID do cliente OAuth 2.0" para "Aplicativo Web"
# 3. Adicione http://localhost:8511 como "Origem JavaScript autorizada"
# 4. Adicione http://localhost:8511/login e http://localhost:8511/register como "URI de redirecionamento autorizada"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

## Chave de Criptografia (para API Keys dos usuários) - OBRIGATÓRIA
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

## Token para acesso ao Dashboard Global
# Gerar: python -c "import secrets; print(secrets.token_urlsafe(32))"
GLOBAL_DASHBOARD_TOKEN=

## Segurança do JWT - OBRIGATÓRIA
# Gerar: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
